{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "generateblocks-pro/form",
  "title": "Form",
  "category": "generateblocks",
  "description": "The form container.",
  "version": "1.0.0",
  "textdomain": "generateblocks-pro",
  "attributes": {
    "uniqueId": {
      "type": "string",
      "default": ""
    },
    "tagName": {
      "type": "string",
      "default": ""
    },
    "styles": {
      "type": "object",
      "default": {}
    },
    "css": {
      "type": "string",
      "default": ""
    },
    "globalClasses": {
      "type": "array",
      "default": []
    },
    "htmlAttributes": {
      "type": "object",
      "default": {}
    },
    "showTemplateSelector": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "align": false,
    "className": false,
    "inserter": false
  },
  "editorScript": "file:./index.js",
  "editorStyle": [
    "file:./index.css"
  ]
}